# Copy to .env (gitignored) and fill in.
#
#   cp .env.example .env

# --- AnyGrasp -----------------------------------------------------------
# The MAC address the AnyGrasp license was issued against. The grasp
# sidecar pins eth0 to this so its feature id can't drift; if it's wrong or
# unset the container fails the license check on startup and says so.
# Normally this workstation's permanent NIC:
#   ls /sys/class/net            # find the physical one (eno1, enp5s0, ...)
#   cat /sys/class/net/eno1/address
ANYGRASP_MAC=

# --- Hugging Face (sam3 ckpt is gated; trellis2 pulls ~15GB) ------------
HF_TOKEN=

# --- ROS 2 --------------------------------------------------------------
# Must match the UR5e box and any other Humble machines on the network.
ROS_DOMAIN_ID=0

# Host dir with rosbag2 recordings; mounted read-only at /bags in Ros2Bridge.
# A bag at <BAG_DIR>/mug is /bags/mug inside the container. Keep this in
# sync with the compose default: an empty value falls back to that default
# rather than erroring, and Docker will create and mount an empty dir.
BAG_DIR=./ros2bags

# Camera topics for the bag / camera in use. `ros2 bag info /bags/<n>` first
# and paste the real names -- these are the defaults for both the bridge
# nodes and run_scene.
#
# NOTE: /camera/camera/depth/color/points is a PointCloud2 and is NOT usable
# here; the bridges need an aligned depth IMAGE plus the colour camera_info.
# `pointcloud.enable` and `align_depth.enable` are independent realsense-ros
# flags, so having the points topic does not mean the aligned depth image was
# recorded. If the bag only has /camera/camera/depth/image_rect_raw, that is
# in the DEPTH optical frame with depth intrinsics: do not point DEPTH_TOPIC
# at it. Re-record with align_depth.enable:=true, or run depth_image_proc's
# register node (which also needs /tf_static and both camera_infos in the bag).
RGB_TOPIC=/camera/camera/color/image_raw
DEPTH_TOPIC=/camera/camera/aligned_depth_to_color/image_raw
INFO_TOPIC=/camera/camera/color/camera_info
