# Copy to .env (gitignored) and fill in.
#
#   cp .env.example .env

# --- AnyGrasp -----------------------------------------------------------
# The MAC address the AnyGrasp license was issued against. The grasp
# sidecar pins eth0 to this so its feature id can't drift; if it's wrong or
# unset the container fails the license check on startup and says so.
# Normally this workstation's permanent NIC:
#   ls /sys/class/net            # find the physical one (eno1, enp5s0, ...)
#   cat /sys/class/net/eno1/address
ANYGRASP_MAC=

# --- Hugging Face (sam3 ckpt is gated; trellis2 pulls ~15GB) ------------
HF_TOKEN=

# --- ROS 2 --------------------------------------------------------------
# Must match the UR5e box and any other Humble machines on the network.
ROS_DOMAIN_ID=0
