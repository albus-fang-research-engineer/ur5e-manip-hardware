# SAM 3 sidecar (ZMQ open-vocabulary segmentation server)
#
# Base: cu128 devel + miniconda (same recipe as trellis2 -- no official
# image). SAM 3 wants python >=3.12, torch >=2.7, CUDA >=12.6; we mirror the
# repo README's recommended pins (py3.12, torch 2.10.0 cu128). Torch cu12x
# wheels run on any >=525 driver via CUDA minor-version compat, so the host
# 535 driver is fine; NVIDIA_DISABLE_REQUIRE=1 silences the base-image check.
#
# The optional "faster inference" extras from the README are deliberately
# skipped:
#   - flash-attn-3 is Hopper-only (sm90+); useless on the 3090 (sm86).
#   - cc_torch (CUDA connected components) is a nice-to-have; uncomment the
#     layer below if mask postprocessing becomes the bottleneck.
#
# Checkpoints are GATED on Hugging Face: request access at
# https://huggingface.co/facebook/sam3 (and /sam3.1 for the multiplex ckpt),
# then export HF_TOKEN in your shell -- compose passes it through. First run
# pulls sam3.pt (~3.4GB, 848M params) into HF_HOME; mount the cache so
# container re-creates don't re-download.

FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_DISABLE_REQUIRE=1

# RTX 3090 = Ampere sm_86. Same convention as the other sidecars.
ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV MAX_JOBS=4

RUN apt-get update && apt-get install -y --no-install-recommends \
        git wget ca-certificates build-essential ninja-build \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Miniconda + sam3 env (python 3.12, torch 2.10.0 cu128 -- mirrors the
# upstream README's conda recipe)
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/conda.sh && \
    bash /tmp/conda.sh -b -p /opt/conda && rm /tmp/conda.sh

# conda-anaconda-tos plugin blocks non-interactive builds (see
# Dockerfile.trellis2 for the gory details).
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda create -y -n sam3 python=3.12 && conda activate sam3 && \
    pip install --no-cache-dir torch==2.10.0 torchvision \
        --index-url https://download.pytorch.org/whl/cu128

# SAM3_COMMIT pin: SAM 3.1 checkpoints need post-03/2026 model code; if you
# ever pin earlier than that, also set SAM3_VERSION=sam3 in the compose env.
ARG SAM3_COMMIT=main
RUN git clone https://github.com/facebookresearch/sam3 /opt/sam3 && \
    cd /opt/sam3 && git checkout ${SAM3_COMMIT}

WORKDIR /opt/sam3

# Deps are light (timm, ftfy, iopath, huggingface_hub, numpy<2) -- no CUDA
# extension builds, so no --no-build-isolation dance needed.
RUN source /opt/conda/etc/profile.d/conda.sh && conda activate sam3 && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir pyzmq msgpack msgpack-numpy pillow

# Optional: CUDA connected-components for faster mask postprocessing.
# RUN source /opt/conda/etc/profile.d/conda.sh && conda activate sam3 && \
#     pip install --no-cache-dir einops ninja && \
#     pip install --no-cache-dir git+https://github.com/ronghanghu/cc_torch.git

# Weights are NOT baked in (gated HF repo + auth token, so they can't be).
# build_sam3_image_model() hf_hub_download's facebook/sam3 into HF_HOME on
# first run -- mount it:
#   ./sam3_runtime/hf_cache -> /opt/hf_cache
#   ./sam3_server           -> /opt/sam3_server
RUN source /opt/conda/etc/profile.d/conda.sh && conda activate sam3 && \
    pip install --no-cache-dir "setuptools<82"
RUN source /opt/conda/etc/profile.d/conda.sh && conda activate sam3 && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir pyzmq msgpack msgpack-numpy pillow einops pycocotools psutil
ENV HF_HOME=/opt/hf_cache
ENV PYTHONPATH=/opt/sam3
# GeForce (sm86) doesn't support CUDA forward compat; nuke the compat libcuda
# so the entrypoint falls back to the host 535 driver (minor-version compat).
RUN rm -rf /usr/local/cuda/compat
CMD ["bash", "-lc", "source /opt/conda/etc/profile.d/conda.sh && conda activate sam3 && python /opt/sam3_server/server.py"]