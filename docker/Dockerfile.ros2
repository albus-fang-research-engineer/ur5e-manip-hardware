# ROS2 Humble bridge container (development image)
#
# Deliberately contains NO perception code and NO CUDA. It runs thin rclpy
# nodes that are ZMQ clients of the pose / pointso / grasp sidecars and
# republish results as ROS topics. This keeps ROS's python 3.10 pin out of
# the FoundationPose (Ubuntu 20.04 conda) and SoFar (py3.12) environments.
#
# Development-style: the colcon workspace is bind-mounted from the host at
# /root/ros2_ws (see docker-compose.yml), so nothing is baked into the image.
# Edit on host, then inside the container:
#   cd /root/ros2_ws && colcon build --symlink-install && source install/setup.bash
#
# Runs with network_mode: host + ipc: host so DDS discovery works with the
# robot and any other ROS2 machines on the LAN without multicast-over-bridge
# headaches. Set ROS_DOMAIN_ID in compose to match the rest of your system.

FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    build-essential \
    git \
    vim \
    iputils-ping \
    net-tools \
    ros-humble-cv-bridge \
    ros-humble-vision-msgs \
    ros-humble-sensor-msgs-py \
    ros-humble-tf2-ros \
    ros-humble-message-filters \
    ros-humble-ros2bag \
    ros-humble-rosbag2-storage-default-plugins \
    ros-humble-rosbag2-storage-mcap \
    ros-humble-tf2-tools \
    ros-humble-visualization-msgs \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# GUI / debugging tools.
#
# A SEPARATE layer on purpose. Appending these to the block above would
# invalidate its cache and rebuild every layer after it; this way the slow,
# stable base install stays cached and only this layer rebuilds when the GUI
# package set changes.
#
# rviz2 only -- NOT ros-humble-desktop. desktop pulls several GB of demos,
# tutorials and simulation packages that have no business in a bridge image
# whose entire job is thin rclpy ZMQ clients. rviz2 + its Qt/OGRE deps is
# already ~800MB.
#
# libgl1-mesa-dri is the software-GL fallback (llvmpipe). With the NVIDIA
# runtime and NVIDIA_DRIVER_CAPABILITIES=graphics the driver's own GL is
# injected and this goes unused -- but without it, a host missing that setup
# gives a black viewport rather than a slow one, which is a much worse thing
# to debug.
#
# zstd: `ros2 bag play` on a *.mcap.zstd decompresses to a sibling file inside
# the bag directory, which fails with errno(30) EROFS on the read-only /bags
# mount. The message says "failed to open ... for binary writing", which reads
# like a corrupt bag and isn't. Decompress once by hand instead:
#     zstd -d mug_0.mcap.zstd && rm mug_0.mcap.zstd
#     # then drop the .zstd suffix from relative_file_paths in metadata.yaml
#     # and blank out compression_format / compression_mode
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rviz2 \
    ros-humble-rqt-image-view \
    ros-humble-rqt-graph \
    libgl1-mesa-dri \
    zstd \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir pyzmq msgpack msgpack-numpy numpy scipy opencv-python-headless

# Auto-source ROS and the workspace overlay (if built) in every interactive shell
RUN echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc && \
    echo '[ -f /root/ros2_ws/install/setup.bash ] && source /root/ros2_ws/install/setup.bash' >> /root/.bashrc

# Workspace is a bind mount -- created here only so WORKDIR exists image-side
WORKDIR /root/ros2_ws

CMD ["/bin/bash"]
