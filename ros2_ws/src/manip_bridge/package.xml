<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manip_bridge</name>
  <version>0.1.0</version>
  <description>rclpy bridge nodes between ROS2 and the ZMQ perception sidecars.</description>
  <maintainer email="albus.fang.research.engineer@gmail.com">Albus Fang</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>manip_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>message_filters</depend>
  <depend>python3-scipy</depend>
  <depend>python3-opencv</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
